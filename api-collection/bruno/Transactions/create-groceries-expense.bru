meta {
  name: Create groceries expense
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "type": "Expense",
    "amount": 42.99,
    "date": "{{monthDate}}-15",
    "categoryId": "{{groceriesCategoryId}}",
    "description": null
  }
}

vars:post-response {
  groceriesTransactionId: res.body.id
}

assert {
  res.status: eq 201
}
