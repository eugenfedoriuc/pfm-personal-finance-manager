meta {
  name: Create category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Sparen",
    "type": "Expense",
    "icon": "savings",
    "color": "#ad1457"
  }
}

vars:post-response {
  scratchCategoryId: res.body.id
}

assert {
  res.status: eq 201
}

tests {
  test("normalises the colour and returns a Location header", function() {
    expect(res.getBody().color).to.equal("#AD1457");
    expect(res.getHeader("location")).to.contain(res.getBody().id);
  });
}
