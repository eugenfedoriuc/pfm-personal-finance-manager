meta {
  name: Create duplicate category (409)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "miete",
    "type": "Expense",
    "icon": "home",
    "color": "#1565C0"
  }
}

assert {
  res.status: eq 409
}

tests {
  test("the unique index ignores case", function() {
    expect(res.getBody().title).to.equal("Konflikt");
  });
}
